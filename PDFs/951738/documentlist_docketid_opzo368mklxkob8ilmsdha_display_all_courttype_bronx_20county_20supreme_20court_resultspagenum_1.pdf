  <div id="container" class="pageWithLeftMenu">
  <button class="menuBurger" onclick="toggleMenu()">Open Menu &#x2630;</button>

  <style media="all">
    /* Hide burger at default zoom */
    button.menuBurger {
      display: none;
      width: 8em;
      margin: 0.25em;
    }

    /* Hide menu and display burger ~200% zoom */
    @media screen and (max-width: 60em) {
      #menu {
        display: block;
        padding-left: 0;
        transform: translateX(-100%);
      }
      #pageContent { padding-left: 0 }
      button.menuBurger { display: block }

      /* Open menu from the left */
      #menu.menu-open { transform: translateX(0) }
      #pageContent.menu-open { padding-left: var(--menu-width, 10em) }
      button.menuBurger.menu-open { margin-left: calc(var(--menu-width, 10em) + 0.25em) }

      /* Transition animations */
      #menu.transition-animation { transition: transform 0.2s ease }
      #pageContent.transition-animation { transition: padding-left 0.2s ease }
      button.menuBurger.transition-animation { transition: margin-left 0.2s ease }
    }

    /* Vertical menu ~400% zoom */
    @media screen and (max-width: 30em) {
      #menu {
        display: none;
        width: 100% !important;
      }
      #pageContent { padding-top: 0 }

      /* Open menu from the top */
      #menu.menu-open {
        display: block;
        margin-top: 1.9em;
      }
      #pageContent.menu-open {
        padding-left: 0;
        padding-top: var(--menu-height, 30em);
        margin-left: 0;
      }
      button.menuBurger.menu-open { margin-left: 0.25em }

      /* Disable transition animations :( */
      #menu.transition-animation { transition: none }
      #pageContent.transition-animation { transition: none }
      button.menuBurger.transition-animation { transition: none }
    }
  </style>

  <script>
    // Trigger on page load to ensure all elements exist
    document.addEventListener("DOMContentLoaded", () => {
      // Cache elements as const so they only get queried once
      const menu = document.getElementById("menu");
      const pageContent = document.getElementById("pageContent");
      const burgerButton = document.querySelector("button.menuBurger")
      const elements = [ menu, pageContent, burgerButton ];

      // Store menu width as a global CSS variable and keep it in sync
      // This will be used to set padding for menu opening from left
      const widthObserver = new ResizeObserver((entries) => {
        for (let entry of entries) {
          document.documentElement.style.setProperty(
            "--" + entry.target.id + "-width",
            entry.contentRect.width + "px"
          );
        }
      });
      widthObserver.observe(menu);

      // Store menu height as a global CSS variable and keep it in sync
      // This will be used to set padding for menu opening from top
      const heightObserver = new ResizeObserver((entries) => {
        for (let entry of entries) {
          document.documentElement.style.setProperty(
            "--" + entry.target.id + "-height",
            entry.contentRect.height + "px"
          );
        }
      });
      heightObserver.observe(menu);

      // Make menu unfocusable if initial screen size is small enough to trigger hiding the menu
      if (window.matchMedia("(max-width: 60em)").matches) {
        menu.inert = true;
      }

      // Adjust menu focusability depending on viewport size/menu visibility
      window.matchMedia("(max-width: 60em)").addEventListener("change", (e) => {
        const menu = document.getElementById("menu");
        if (e.matches && !menu.classList.contains("menu-open")) {
          // Small viewport w/ hidden menu: menu not focusable
          menu.inert = true;
        } else {
          // Larger viewport or menu open: menu is focusable
          menu.inert = false;
        }
      })

      // Callback function to open/close menu
      window.toggleMenu = () => {
        // Add transition animation and listener to remove transition once it finishes
        // EventListener cleans itself up after firing once
        elements.forEach(element => {
          element.classList.add("transition-animation");
          element.addEventListener("transitionend", () => element.classList.remove("transition-animation"), { once: true });
        });

        if (menu.classList.contains("menu-open")) {
          // Close menu
          elements.forEach(element => element.classList.remove("menu-open"));
          burgerButton.textContent = "Open Menu \u2630"
          menu.inert = true; // Menu unfocusable when closed
        } else {
          // Open menu
          elements.forEach(element => element.classList.add("menu-open"));
          burgerButton.textContent = "Close Menu \u2715"
          menu.inert = false; // Menu focusable when opened
        }
      }
    });
  </script>

