  <style media="all">
    @media screen and (max-width:82em) {

      /* page shell */
      body                    { min-width:0 !important }
      a                       { white-space:normal !important }

      /* layout */
      #container              { display:flex; flex-direction:column; padding-left:0; width:100% }
      #menu                   { width:10em !important; padding-left:8em !important;}
      #pageContent            { display:block; width:100% !important; float:none; border-left:none !important; margin-left:0; padding:0.5em 2%; padding-left:10em; box-sizing:border-box }

      /* site header */
      #UCS_Header             { height:auto; min-height:2.5em; box-sizing:border-box }
      #UCS_Title              { width:auto }
      #UCS_Application        { width:auto; text-indent:0; padding-left:1em; white-space:normal; overflow-wrap:break-word; box-sizing:border-box }

      /* page content */
      main                    { padding: 0.25em 0.5em }
      textarea                { width:100% !important; max-width:100% !important; box-sizing:border-box }
      select                  { max-width:100% !important; box-sizing:border-box }
      input[type="text"]      { max-width:100% !important; box-sizing:border-box }
      input[type="file"]      { max-width:100%; box-sizing:border-box }
      div.DocumentBlock       { width:96% !important; box-sizing:border-box }
      div.tabBody             { width:auto !important; max-width:100% !important; box-sizing:border-box }
      div.DataEntry_InnerBox  { max-width:100% !important; box-sizing:border-box }
      /* div.DataEntry_InnerBox span input { width: 95%; } */
      div.MessageBox_Blue     { max-width:100% !important; box-sizing:border-box }
      div.MsgBox_Yellow       { max-width:100% !important; box-sizing:border-box }
      div.MsgBox_Yellow p     { width:auto !important; max-width:100% !important }
      span.MsgBox_Message     { max-width:100% !important; box-sizing:border-box }
      p.desc                  { width:auto !important; max-width:100% !important }
      p.Requirements          { width:auto !important; max-width:100% !important }
      div.DataEntry_InnerBox p.Requirements           { width:auto !important; max-width:100% !important }
      div.DataEntry_InnerBox div.MessageBox_Blue p.Requirements { width:auto !important; max-width:100% !important }
      .MsgBox_PDF p           {padding-left:4.5em;padding-bottom:0;width: auto !important;font-size:.7em;}

      /* tables — allow horizontal scroll instead of overflowing the page */
      table.NewSearchResults  { min-width:0 !important; max-width:90% !important; overflow-x:auto; box-sizing:border-box }
      table.dataList          { white-space:normal; overflow-x:auto; display:block; }

      /* MsgBox_Lock reflow — prevent background-image overlap and text clipping */
      div.MsgBox_Lock         { background-size:1.8em auto !important; background-position:0.5em 0.6em !important; padding-left:3em !important; box-sizing:border-box; width:auto !important; max-width:100% }
      div.MsgBox_Lock h2      { margin-left:0 !important; margin-top:0 !important }
      div.MsgBox_Lock span.DataEntry_Row { height:auto !important; width:auto !important; max-width:100%; padding-left:0 !important; line-height:1.5em }

      /* MsgBox_Alert reflow — prevent background-image overlap */
      div.MsgBox_Alert        { margin-right:0; box-sizing:border-box; background-size:1.5em auto !important; background-position:0.5em 0.5em !important; padding-left:3em !important; max-width:100% }
      div.MsgBox_Alert .heading,
      div.MsgBox_Alert .message { padding-left:0 !important }

      div.MsgBox_Instruction        { margin-right:0; box-sizing:border-box; background-size:1.5em auto !important; background-position:0.5em 0.5em !important; padding-left:3em !important; max-width:100% }
      div.MsgBox_Instruction .heading,
      div.MsgBox_Instruction .message { padding-left:0 !important }

      /* MsgBox_Requirement reflow */
      .MsgBox_Requirement                 { background-size:1.5em auto !important; background-position:0.5em 0.5em !important; padding-left:3em !important; margin-left:0 !important; box-sizing:border-box; max-width:100% }
      .MsgBox_Requirement .MsgBox_Message { padding-left:0 !important; max-width:100%; }

      /* fieldsets */
      fieldset {min-width:0 !important;}

      /* Left menu */
      div.pageWithLeftMenu { width:auto; text-indent:0; white-space:normal; overflow-wrap:break-word; box-sizing:border-box }

      /* filing-step breadcrumbs */
      #filingSteps            { display:flex; align-items:flex-start; width:100%; background-size:2.5em auto; background-position:left 0.3em }
      #filingSteps .container { flex:1; min-width:0; margin:0.5em 0 0.45em 3em }
      #filingList             { display:flex; flex-wrap:wrap; padding-bottom:10px }
      #filingList li.active   { background-size:14px auto; background-position:center bottom 2px }

      /* wizard buttons */
      span.wizardButtons      { display:flex; flex-wrap:wrap; justify-content:center; gap:0.5em }
      span.wizardButtons input.yellow { float:none; margin-right:0 }

      /* footer */
      #fMenu span             { width:auto; display:block; margin-bottom:0.5em }
    }

    @media screen and (max-width:30em) {
      table.NewSearchResults {
        min-width: 0 !important;
        max-width: 90% !important;
        overflow-x: auto !important;
        box-sizing: border-box !important;
        /* display:block is applied via JS only when table width > 60px */
      }
    }

  </style>

  <script>
    (function () {
      function reflowTables() {
        var isNarrow = window.matchMedia('(max-width:30em)').matches;
        var tables = document.querySelectorAll('table.NewSearchResults');
        for (var i = 0; i < tables.length; i++) {
          if (isNarrow && tables[i].scrollWidth > 60) {
            tables[i].style.display = 'block';
          } else {
            tables[i].style.display = '';
          }
        }
      }
      window.addEventListener('resize', reflowTables);
      window.addEventListener('load', reflowTables);
    })();
  </script>

